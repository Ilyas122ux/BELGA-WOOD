{
  "name": "@jad-home/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "dev:watch": "tsx watch --clear-screen=false --exclude ../shared/dist/** --exclude dist/** --exclude storage/** src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src/app.ts src/index.ts src/belga src/config/env.ts src/middleware/errorHandler.ts src/middleware/notFoundHandler.ts src/services/rateLimit.ts --max-warnings=0",
    "test": "vitest run src/tests/belga-isolation.test.ts",
    "seed": "tsx src/seed.ts",
    "hash-password": "tsx src/utils/hashPassword.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@jad-home/shared": "*",
    "bcrypt": "^6.0.0",
    "compression": "^1.8.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "express-session": "^1.18.1",
    "googleapis": "^173.0.0",
    "helmet": "^8.1.0",
    "multer": "^2.0.0",
    "proper-lockfile": "^4.1.2",
    "write-file-atomic": "^6.0.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@types/bcrypt": "^5.0.2",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.18",
    "@types/express": "^5.0.2",
    "@types/express-session": "^1.18.1",
    "@types/multer": "^1.4.13",
    "@types/node": "^22.15.0",
    "@types/proper-lockfile": "^4.1.4",
    "@types/supertest": "^6.0.3",
    "exceljs": "^4.4.0",
    "eslint": "^9.28.0",
    "globals": "^16.2.0",
    "supertest": "^7.1.1",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.34.0",
    "vitest": "^3.2.0",
    "sharp": "^0.34.2"
  }
}
