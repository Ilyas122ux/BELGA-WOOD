[Unit]
Description=JAD HOME local availability, backup and disk checks
After=jad-home.service nginx.service
OnFailure=jad-home-alert@%n.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/jad-home/current
EnvironmentFile=/etc/jad-home/jad-home.env
ExecStart=/opt/jad-home/current/scripts/monitor-local.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/srv/jad-home/data
